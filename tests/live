#!/usr/bin/env bash
# Live check on a running Omarchy desktop with the plugin enabled. It opens the
# audio panel for a few seconds, nudges the output volume by 1% a few times,
# puts it back, and counts the tones the plugin plays. You will hear them and
# see the panel and the volume OSD. Needs pactl and pw-mon (base install).
set -uo pipefail

# The sink whose level the keys and the audio panel move, as the plugin sees it.
sink="$(omarchy-audio-output-sink 2>/dev/null || pactl get-default-sink)"
out="$(mktemp)"
trap 'rm -f "$out"; omarchy-shell -q omarchy.audio close' EXIT
failed=0

level() { pactl get-sink-volume "$sink" | grep -o '[0-9]*%' | head -1; }

# Tones are counted by the unique serials of the plugin's own stream nodes.
tones() {
  awk '
    /^(added|changed|removed):/ { if (hit && ser != "") seen[ser] = 1; hit = 0; ser = "" }
    /object\.serial = / { gsub(/[^0-9]/, "", $0); ser = $0 }
    /node\.name = "omarchy_speaker_tuning\.volume-beep"/ { hit = 1 }
    END { if (hit && ser != "") seen[ser] = 1; n = 0; for (k in seen) n++; print n }
  ' "$out"
}

expect() {
  local name=$1 want=$2 seconds=$3 got
  shift 3
  timeout "$seconds" pw-mon -N >"$out" 2>/dev/null &
  sleep 0.5
  "$@"
  wait
  got=$(tones)
  if [[ $got == "$want" ]]; then
    printf 'ok    %-40s %s tone(s)\n' "$name" "$got"
  else
    printf 'FAIL  %-40s %s tone(s), expected %s\n' "$name" "$got" "$want"
    failed=1
  fi
}

press() { pactl set-sink-volume "$sink" -1%; sleep 0.6; }
back() { pactl set-sink-volume "$sink" +1%; sleep 0.6; }
there_and_back() { press; back; }
slide() {
  local i
  for i in $(seq 1 10); do pactl set-sink-volume "$sink" -1%; sleep 0.05; done
  for i in $(seq 1 10); do pactl set-sink-volume "$sink" +1%; sleep 0.05; done
}
# What the volume keys run: it changes the level and raises the OSD.
keys() {
  omarchy-audio-output-volume -1 >/dev/null
  sleep 0.6
  omarchy-audio-output-volume +1 >/dev/null
  sleep 0.6
}

before=$(level)
if [[ ${before%\%} -lt 15 ]]; then
  echo "Volume is at $before; raise it above 15% so 1% steps down are real changes." >&2
  exit 2
fi

omarchy-shell -q omarchy.audio close
sleep 0.5
expect "panel closed: two changes" 0 3 there_and_back
expect "panel closed: volume keys" 0 3 keys
sleep 1.5 # let the OSD leave

omarchy-shell -q omarchy.audio open
sleep 0.8
expect "panel open: one change" 1 2 press
expect "panel open: one change back" 1 2 back
expect "panel open: a slide of 20 changes" 1 3 slide
expect "panel open: volume keys" 0 3 keys
omarchy-shell -q omarchy.audio close

echo "volume before $before, after $(level)"
exit $failed
